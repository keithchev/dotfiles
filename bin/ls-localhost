#!/usr/bin/env bash
#
# List processes listening on TCP ports, one row per process, with the full
# command line and working directory (so you can tell which `python` or `node`
# is which dev server).
#
#   ls-localhost                 all listening processes
#   ls-localhost python node     only those whose command line matches any pattern
#   ls-localhost -d              only dev-server runtimes (python, node, bun, ...)
#
# Patterns are case-insensitive extended regexes matched against the full command
# line; -d matches the executable name only. Only your own processes are shown
# unless run with sudo.

set -euo pipefail

usage() { sed -n '7,9s/^# *//p' "$0" >&2; exit "${1:-1}"; }

# Executable names (basename of argv[0]) counted as dev servers by -d.
DEV_EXE='^(python[0-9.]*|node|bun|deno|ruby|php|java|uvicorn|gunicorn|hypercorn|flask|jupyter.*|streamlit|vite|next|esbuild|go|cargo)$'

patterns=()
exe_filter=""
while (($#)); do
  case "$1" in
    -d|--dev) exe_filter="$DEV_EXE" ;;
    -h|--help) usage 0 ;;
    -*) usage ;;
    *) patterns+=("$1") ;;
  esac
  shift
done
filter=$(IFS='|'; echo "${patterns[*]:-}")

# pid<TAB>port pairs, deduped (IPv4 and IPv6 listeners on the same port collapse).
listeners=$(lsof -iTCP -sTCP:LISTEN -n -P -Fpn 2>/dev/null |
  awk '/^p/ {pid=substr($0,2)} /^n/ {n=$0; sub(/.*:/,"",n); print pid "\t" n}' |
  sort -u -t$'\t' -k1,1n -k2,2n)

[[ -z "$listeners" ]] && { echo "no listening TCP ports found" >&2; exit 0; }

pids=$(cut -f1 <<<"$listeners" | sort -un | paste -sd, -)

# pid<TAB>cwd for every listening process, from a single lsof call.
cwds=$(lsof -a -p "$pids" -d cwd -Fpn 2>/dev/null |
  awk '/^p/ {pid=substr($0,2)} /^n/ {print pid "\t" substr($0,2)}')

# pid<TAB>full command line.
cmds=$(ps -o pid=,args= -p "$pids" | sed -E 's/^ *([0-9]+) +/\1\t/')

width=$(tput cols 2>/dev/null || echo 0)
[[ -t 1 ]] || width=0  # don't truncate when piped

rows=$({
  sed 's/^/L\t/' <<<"$listeners"
  sed 's/^/W\t/' <<<"$cwds"
  sed 's/^/C\t/' <<<"$cmds"
} | awk -F'\t' -v home="$HOME" -v filter="$filter" -v exe_filter="$exe_filter" '
  # ports arrive sorted per pid; collapse consecutive runs into ranges (9000-9004)
  $1 == "L" { p = $3 + 0
              if (!($2 in minport)) { minport[$2] = p; ports[$2] = p }
              else if (p == last[$2] + 1) { ports[$2] = run[$2] "-" p }
              else { ports[$2] = ports[$2] "," p; run[$2] = ports[$2] }
              if (!($2 in run)) run[$2] = ports[$2]
              last[$2] = p; next }
  $1 == "W" { cwd[$2] = $3; next }
  $1 == "C" { cmd[$2] = $3; next }
  END {
    for (pid in ports) {
      c = cmd[pid]
      if (filter != "" && tolower(c) !~ tolower(filter)) continue
      # shorten the executable path to its basename, keep the arguments
      exe = c; sub(/ .*/, "", exe); n = split(exe, segs, "/")
      if (exe_filter != "" && tolower(segs[n]) !~ exe_filter) continue
      c = segs[n] substr(c, length(exe) + 1)
      gsub(home "/", "~/", c)
      d = cwd[pid]; if (index(d, home) == 1) d = "~" substr(d, length(home) + 1)
      if (d == "") d = "?"
      if (length(d) > 40) d = "…" substr(d, length(d) - 38)
      printf "%010d\t%s\t%s\t%s\t%s\n", minport[pid], ports[pid], pid, d, c
    }
  }' | sort | cut -f2-)

[[ -z "$rows" ]] && { echo "no matching listeners" >&2; exit 1; }

printf 'PORT\tPID\tCWD\tCOMMAND\n%s\n' "$rows" | awk -F'\t' -v width="$width" '
    # column-align the first three fields; command gets whatever width is left
    { rows[NR] = $0; for (i = 1; i <= 3; i++) if (length($i) > w[i]) w[i] = length($i) }
    END {
      for (r = 1; r <= NR; r++) {
        split(rows[r], f, "\t")
        line = sprintf("%-" w[1] "s  %-" w[2] "s  %-" w[3] "s  %s", f[1], f[2], f[3], f[4])
        if (width > 0 && length(line) > width) line = substr(line, 1, width - 1) "…"
        print line
      }
    }'
