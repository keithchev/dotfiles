# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local

[alias]
        co = checkout
        promote = !$DOTFILES/bin/git-promote
        wtf     = !$DOTFILES/bin/git-wtf
        rank-contributors = !$DOTFILES/bin/git-rank-contributors
        count   = !git shortlog -sn
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

        # commands for reading unfamiliar codebases
        # (from piechowski.io/post/git-commands-before-reading-code)
        most-changed-files = !git log --format=format: --name-only --since=\"1 year ago\" | sort | uniq -c | sort -nr | head -20
        top-contributors = !git shortlog -sn --no-merges
        top-bug-fix-files = !git log -i -E --grep=\"fix|bug|broken\" --name-only --format='' | sort | uniq -c | sort -nr | head -20
        commit-counts = "!f() { case \"${1:-month}\" in day) fmt='%Y-%m-%d';; month) fmt='%Y-%m';; year) fmt='%Y';; *) echo 'Usage: git commit-counts [day|month|year]'; return 1;; esac; git log --format=\"%ad\" --date=format:\"$fmt\" | sort | uniq -c; }; f"
        firefights = !git log --oneline --since=\"1 year ago\" | grep -iE 'revert|hotfix|emergency|rollback'

[color]
        diff = auto
        status = auto
        branch = auto
        ui = true

[core]
        pager = delta
	editor = git-editor

[pager]
	branch = false

[diff]
        algorithm = histogram
        colorMoved = default

[difftool]
        prompt = false

[help]
        autocorrect = 1

[init]
	defaultBranch = main

[branch]
        # sort branches by date in `git branch`
	sort = -committerdate

[merge]
	conflictstyle = zdiff3
	tool = meld

[push]
	autoSetupRemote = true
	negotiate = true

[interactive]
    diffFilter = delta --color-only

[delta]
    light = false
    line-numbers = true
    side-by-side = false
    # use n and N to move between diff sections
    navigate = true
[fetch]
	negotiationAlgorithm = skipping
